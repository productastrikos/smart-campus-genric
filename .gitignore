node_modules/
.DS_Store
*.log

# Built output inside the source tree. The DEPLOYED build lives at the repo
# root (index.html, assets/, images/, api-data/) and is committed on purpose —
# Hostinger serves the root directory directly. Only src-app/dist, the scratch
# output of a local build, is ignored.
src-app/dist/

# The CCTV demo clips ARE tracked, ONCE, at the repository root (/videos,
# /v4.mp4, /v5.mp4, /v9.mp4) — that is the directory Hostinger serves, so the
# footage has to ship with the site.
#
# Their copies inside the source tree are ignored: they are byte-identical, and
# committing ~300 MB of video twice buys nothing. `npm run build:static` runs
# scripts/sync-videos.mjs first, which copies them back from the root, so a
# fresh clone still builds a site with working footage.
src-app/client/public/videos/
src-app/client/public/*.mp4

# GitHub hard-rejects any single file over 100 MB, which is why
# building/b1.mp4 (265 MB), generic/v1.mp4 (170 MB) and building/b2.mp4
# (103 MB) are absent. Compress them under 100 MB to add them, and re-list
# them in the clip pools in cameras.js / cameraRegistry.js.
